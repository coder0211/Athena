# Keep the build context small — these are mounted at runtime, not baked in.
venv/
.venv/
.sources/
.knowledge/
**/.codegraph/
**/graphify-out/
**/__pycache__/
*.pyc
.git/
.env
# Runtime config is bind-mounted from ./config, not baked into the image
# (the example.* templates stay, so a fresh image still ships the samples).
config/sources.yaml
config/workspace.yaml
config/docs.yaml
config/personas.yaml
config/mcp_servers.json
.mypy_cache/
.ruff_cache/
.pytest_cache/

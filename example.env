# Copy to .env and fill in.  Loaded automatically by the API and MCP server.

# --- LLM provider (natural-language Q&A) ---------------------------------
# Q&A (POST /api/ask, the "Ask" tab) runs against any OpenAI-compatible Chat
# Completions API. Without a key/endpoint the UI falls back to structured search.

# API key. For OpenAI, paste your key here. ATHENA_API_KEY is an alias that wins
# if both are set. A local endpoint (Ollama, vLLM, LM Studio) may need no key.
OPENAI_API_KEY=
# ATHENA_API_KEY=

# Point at a non-OpenAI, OpenAI-compatible endpoint to use a different provider
# (local model, OpenRouter, Together, etc.). Leave unset for OpenAI itself.
# Examples:
#   ATHENA_API_BASE=http://localhost:11434/v1        # Ollama
#   ATHENA_API_BASE=https://openrouter.ai/api/v1     # OpenRouter
# ATHENA_API_BASE=

# Model used for Q&A (optional; any model on your provider with tool support).
ATHENA_ASK_MODEL=gpt-4.1-nano

# Q&A sampling temperature (optional; default 0.3). Lower = more focused/deterministic
# and converges in fewer tool rounds; higher = more varied wording.
# Set to `none` (or off/default) to omit it entirely — some reasoning models
# (o-series, gpt-5) reject a custom temperature.
ATHENA_TEMPERATURE=0.3
# Max tokens for a single Q&A answer (optional; default 2048). Raise for longer,
# more detailed answers (costs more); lower to keep answers short.
ATHENA_MAX_TOKENS=2048

# Advanced provider knobs (optional) — only needed for non-standard models:
# Rename the token-limit param (reasoning models want max_completion_tokens).
# ATHENA_TOKENS_PARAM=max_tokens
# Set false to omit parallel_tool_calls (rejected by some models).
# ATHENA_PARALLEL_TOOL_CALLS=true
# Force a real tool call on the first round (tool_choice=required) so a small
# model can't just narrate ("I'll check the docs") or print functions.x(...) as
# text and stop. Set false if your provider rejects tool_choice=required.
# ATHENA_FORCE_FIRST_TOOL=true

# Path to the built knowledge graph (optional; default: <repo>/.knowledge/graph.json).
ATHENA_GRAPH=.knowledge/graph.json

# --- Tunable limits (all optional; defaults shown match the code) ---
# Max tool-calling rounds the Q&A agent may take per question (default 16).
ATHENA_MAX_STEPS=50
# Max characters of a single tool result fed back to the model (default 12000;
# 0 = uncapped). Caps how much a wide search / deep scan can bloat the context.
ATHENA_TOOL_RESULT_CHARS=12000
# Max lines returned by a single source-code read (default 400; higher = more
# context, more tokens).
ATHENA_MAX_CODE_LINES=400
# Extra lines shown around a symbol when reading its source (default 15).
ATHENA_CODE_CONTEXT=15
# Default graph depth (hops) for impact / blast-radius traversal (default 10).
ATHENA_IMPACT_DEPTH=10
# Default max length (hops) for shortest-path search between two symbols (default 20).
ATHENA_PATH_MAX_LEN=20

# --- Documents knowledge source (docx/pdf/csv/xls ingestion) -------------
# Folders to scan are configured in docs.yaml (Documents tab) + uploads under
# .docs/uploads/. The paths below only override the defaults; leave unset normally.
# docs.yaml location (default: <repo>/docs.yaml).
# ATHENA_DOCS_CONFIG=docs.yaml
# Upload root, also scanned for documents (default: <repo>/.docs).
# ATHENA_DOCS=.docs
# Where extracted passages + embeddings are stored (default: <repo>/.knowledge/docs).
# ATHENA_DOCS_STORE=.knowledge/docs
#
# Retrieval is HYBRID: BM25 (always, no key) fused with embeddings (when a
# provider above is configured). Embeddings reuse the same ATHENA_API_* keys.
# Embedding model (default: text-embedding-3-small). Point at your provider's model.
ATHENA_EMBED_MODEL=text-embedding-3-small
# Texts per embedding request when indexing (default 128).
# ATHENA_EMBED_BATCH=128
# Fusion weights for BM25 vs. embeddings (defaults 0.5 / 0.5). Raise the embed
# weight for more semantic matching, the BM25 weight for stricter keyword matching.
# ATHENA_BM25_WEIGHT=0.5
# ATHENA_EMBED_WEIGHT=0.5
# Passage chunking (characters per chunk, overlap between chunks).
# ATHENA_DOC_CHUNK_CHARS=1500
# ATHENA_DOC_CHUNK_OVERLAP=150

# Copy to .env and fill in.  Loaded automatically by the API and MCP server.

# Enables natural-language Q&A (POST /api/ask, the "Ask" tab), via the OpenAI API.
# Without it, the UI falls back to structured search.
OPENAI_API_KEY=

# Model used for natural-language Q&A (optional; any OpenAI model with tool support).
ATHENA_ASK_MODEL=gpt-4.1-nano

# Path to the built knowledge graph (optional; default: <repo>/.knowledge/graph.json).
ATHENA_GRAPH=.knowledge/graph.json

# --- Tunable limits (all optional; defaults shown) ---
# Max lines returned by a single source-code read (higher = more context, more tokens).
ATHENA_MAX_CODE_LINES=5000
# Extra lines shown around a symbol when reading its source.
ATHENA_CODE_CONTEXT=100
# Default graph depth (hops) for impact / blast-radius traversal.
ATHENA_IMPACT_DEPTH=10
# Default max length (hops) for shortest-path search between two symbols.
ATHENA_PATH_MAX_LEN=20
# Max tool-calling rounds the Q&A agent may take per question.
ATHENA_MAX_STEPS=16
